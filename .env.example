# Backend (API) — must connect as a NON-superuser, NON-BYPASSRLS role (CC-003/CC-010)
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://erp_app:<SET_APP_DB_PASSWORD>@localhost:5432/construction_erp
JWT_SECRET=<GENERATE_AT_LEAST_32_RANDOM_CHARACTERS>
# Optional (G-013 key rotation): previous signing key, still accepted for verification until old tokens expire (8h)
# JWT_SECRET_PREVIOUS=
BOOTSTRAP_ADMIN_TOKEN=<GENERATE_AT_LEAST_32_RANDOM_CHARACTERS>
# First-run only by default. 'true' lets the bootstrap token create further tenants (test/dev only;
# SaaS tenant creation is an owner-decided commercial provisioning process, DEC-010).
ALLOW_MULTI_TENANT_BOOTSTRAP=false
CORS_ORIGIN=http://localhost:5173

# Migrator only — superuser or BYPASSRLS role (owner of the schema)
MIGRATION_DATABASE_URL=postgresql://erp_owner:<SET_OWNER_DB_PASSWORD>@localhost:5432/construction_erp
APP_DB_ROLE=erp_app
MIGRATIONS_DIR=../database/migrations

# docker-compose
POSTGRES_PASSWORD=<SET_DB_PASSWORD>
APP_DB_PASSWORD=<SET_APP_DB_PASSWORD>

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api
# G-017 login throttling - PROVISIONAL defaults pending the owner's security policy (DEC-015); 0 disables a limit.
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_FAILURE_WINDOW_MINUTES=15
# LOGIN_LOCKOUT_MINUTES=15
# Per-address limit needs the real client IP: set TRUST_PROXY to the proxy hop count in front of the API (e.g. 1 on a single load balancer).
# LOGIN_ADDRESS_MAX_FAILURES=0
# TRUST_PROXY=0
